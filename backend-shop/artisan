#!/usr/bin/env php
<?php

use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Reuse the print backend's installed vendor.
$autoload = require __DIR__ . '/../backend/vendor/autoload.php';
