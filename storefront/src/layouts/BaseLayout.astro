---
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import CookieConsent from '~/components/CookieConsent';
const { title = 'CloudLab Print — premium web-to-print', description = 'Premium online printing on the CloudLab platform. Business cards, flyers, brochures and more — designed online, printed in 24 hours, delivered EU-wide.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />

    <!-- Inter (Google Fonts) — matches CloudLab's corporate sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-900 antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent client:idle />
  </body>
</html>
