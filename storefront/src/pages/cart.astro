---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CartView from '~/components/CartView';
---
<BaseLayout title="Your cart — CloudLab Print">
  <section class="border-b border-slate-200 bg-gradient-to-br from-brand-50 to-white">
    <div class="mx-auto max-w-7xl px-4 py-8 md:py-10">
      <h1 class="text-3xl font-extrabold tracking-tight text-brand-900 md:text-4xl">Your cart</h1>
      <p class="mt-1 text-slate-600">Review your items and place the order. EU delivery is free over €99.</p>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10">
    <CartView client:only="react" />
  </div>
</BaseLayout>
