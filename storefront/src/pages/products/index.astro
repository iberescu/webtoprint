---
import BaseLayout from '~/layouts/BaseLayout.astro';

const apiBase = process.env.INTERNAL_API_URL ?? process.env.PUBLIC_API_URL ?? 'http://localhost:8000/api/v1';
const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('category');

type Product = {
  id: string; slug: string; name: string; description?: string;
  category?: { name: string; slug: string } | null;
  metadata_json?: { from_price?: number; image_color?: string; icon?: string };
};

let products: Product[] = [];
try {
  const params = new URLSearchParams({ per_page: '50' });
  if (selectedCategory) params.set('category', selectedCategory);
  const res = await fetch(`${apiBase}/products?${params}`);
  products = (await res.json())?.data?.data ?? [];
} catch {}

const categories = (() => {
  const map = new Map<string, string>();
  products.forEach((p) => p.category && map.set(p.category.slug, p.category.name));
  return [...map.entries()].map(([slug, name]) => ({ slug, name }));
})();

const heroTitle = selectedCategory ? (categories.find((c) => c.slug === selectedCategory)?.name ?? 'Products') : 'All products';
---
<BaseLayout title={`${heroTitle} — PrintHub`}>
  <!-- Page hero -->
  <section class="border-b border-slate-200 bg-gradient-to-br from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-4 py-8 md:py-12">
      <nav class="text-sm text-slate-500">
        <a href="/" class="hover:text-indigo-600">Home</a> <span class="mx-1">/</span>
        <span class="text-slate-700">{heroTitle}</span>
      </nav>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 md:text-5xl">{heroTitle}</h1>
      <p class="mt-2 text-slate-600">{products.length} products · all prices in EUR · VAT shown at checkout</p>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10">
    <div class="grid gap-10 lg:grid-cols-[240px_1fr]">
      <!-- Sidebar -->
      <aside class="text-sm">
        <div class="sticky top-24 space-y-6">
          <div>
            <h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-500">Categories</h2>
            <ul class="space-y-1">
              <li>
                <a
                  href="/products"
                  class={`block rounded-lg px-3 py-2 ${!selectedCategory ? 'bg-indigo-50 font-bold text-indigo-700' : 'text-slate-700 hover:bg-slate-100'}`}
                >
                  All products
                </a>
              </li>
              {categories.map((c) => (
                <li>
                  <a
                    href={`/products?category=${c.slug}`}
                    class={`block rounded-lg px-3 py-2 ${selectedCategory === c.slug ? 'bg-indigo-50 font-bold text-indigo-700' : 'text-slate-700 hover:bg-slate-100'}`}
                  >
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-xl bg-amber-50 p-4 ring-1 ring-amber-100">
            <div class="text-sm font-bold text-amber-900">Save 20% on first order</div>
            <p class="mt-1 text-xs text-amber-800">Use code <span class="font-mono font-bold">PRINT20</span> at checkout.</p>
          </div>

          <div>
            <h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-500">Why PrintHub?</h2>
            <ul class="space-y-2 text-slate-600">
              <li class="flex gap-2"><span class="text-emerald-600">✓</span> 24h production</li>
              <li class="flex gap-2"><span class="text-emerald-600">✓</span> Free EU delivery from €99</li>
              <li class="flex gap-2"><span class="text-emerald-600">✓</span> Reprint guarantee</li>
              <li class="flex gap-2"><span class="text-emerald-600">✓</span> GDPR-compliant</li>
            </ul>
          </div>
        </div>
      </aside>

      <!-- Grid -->
      <div>
        {products.length === 0 ? (
          <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center text-slate-500">
            No products in this category yet.
          </div>
        ) : (
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {products.map((p) => (
              <a
                href={`/products/${p.slug}`}
                class="group block overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-xl"
              >
                <div class="aspect-[4/3] overflow-hidden bg-slate-100">
                  <img
                    src={`/images/products/${p.slug}.png`}
                    alt={p.name}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    loading="lazy"
                    width="500"
                    height="375"
                  />
                </div>
                <div class="p-5">
                  <div class="text-xs font-medium uppercase tracking-wide text-slate-500">{p.category?.name ?? ''}</div>
                  <div class="mt-1 text-base font-bold text-slate-900 group-hover:text-indigo-600">{p.name}</div>
                  {p.description && <p class="mt-1 line-clamp-2 text-xs text-slate-500">{p.description}</p>}
                  <div class="mt-4 flex items-end justify-between">
                    <div>
                      <div class="text-xs text-slate-500">starting at</div>
                      <div class="text-xl font-extrabold tracking-tight text-slate-900">€{(p.metadata_json?.from_price ?? 0).toFixed(2)}</div>
                    </div>
                    <span class="rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-amber-800">24h</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
