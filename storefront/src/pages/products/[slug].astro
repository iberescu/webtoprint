---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProductConfigurator from '~/components/ProductConfigurator';

type Product = {
  id: string; slug: string; name: string; description?: string;
  category?: { name: string; slug: string } | null;
  requires_design: boolean; allows_pdf_upload: boolean;
  metadata_json?: { from_price?: number; image_color?: string; icon?: string };
};

export async function getStaticPaths() {
  const apiBase = process.env.INTERNAL_API_URL ?? process.env.PUBLIC_API_URL ?? 'http://localhost:8000/api/v1';
  try {
    const res = await fetch(`${apiBase}/products?per_page=200`);
    const list: Product[] = (await res.json())?.data?.data ?? [];
    return list.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
  } catch {
    return [];
  }
}

const { product } = Astro.props as { product: Product };
const { slug } = Astro.params;
---
<BaseLayout title={`${product.name} — PrintHub`} description={product.description ?? undefined}>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <nav class="text-sm text-slate-500">
      <a href="/" class="hover:text-indigo-600">Home</a> <span class="mx-1">/</span>
      <a href="/products" class="hover:text-indigo-600">Products</a>
      {product.category && (
        <><span class="mx-1">/</span><a href={`/products?category=${product.category.slug}`} class="hover:text-indigo-600">{product.category.name}</a></>
      )}
      <span class="mx-1">/</span>
      <span class="text-slate-700">{product.name}</span>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <!-- Image gallery -->
      <div>
        <div class="overflow-hidden rounded-3xl bg-slate-100 shadow-sm ring-1 ring-slate-200">
          <img
            src={`/images/products/${slug}.png`}
            alt={product.name}
            class="aspect-square w-full object-cover"
            width="800"
            height="800"
          />
        </div>
        <div class="mt-3 grid grid-cols-4 gap-3">
          <div class="overflow-hidden rounded-lg ring-2 ring-indigo-500">
            <img src={`/images/products/${slug}.png`} alt="" class="aspect-square w-full object-cover" loading="lazy" width="160" height="160" />
          </div>
          <div class="overflow-hidden rounded-lg opacity-70 hover:opacity-100">
            <img src="/images/banners/hero.png" alt="" class="aspect-square w-full object-cover" loading="lazy" width="160" height="160" />
          </div>
          <div class="overflow-hidden rounded-lg opacity-70 hover:opacity-100">
            <img src="/images/products/business-card.png" alt="" class="aspect-square w-full object-cover" loading="lazy" width="160" height="160" />
          </div>
          <div class="overflow-hidden rounded-lg opacity-70 hover:opacity-100">
            <img src={product.category?.slug ? `/images/banners/category-${product.category.slug}.png` : '/images/products/flyer.png'} alt="" class="aspect-square w-full object-cover" loading="lazy" width="160" height="160" />
          </div>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <div class="text-2xl">🚚</div>
            <div class="mt-1 font-bold text-slate-900">24h production</div>
            <div class="text-xs text-slate-500">Order today, ship tomorrow</div>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <div class="text-2xl">🛡️</div>
            <div class="mt-1 font-bold text-slate-900">Reprint guarantee</div>
            <div class="text-xs text-slate-500">100% satisfaction</div>
          </div>
        </div>
      </div>

      <!-- Configurator -->
      <div>
        <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-slate-500">
          <span class="font-semibold">{product.category?.name}</span>
          <span class="rounded-full bg-amber-100 px-2 py-0.5 font-bold text-amber-800">★ 4.7 (1 280)</span>
        </div>
        <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-slate-900">{product.name}</h1>
        {product.description && <p class="mt-3 text-base leading-relaxed text-slate-600">{product.description}</p>}

        <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
          {product.requires_design && (
            <span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 px-3 py-1 font-semibold text-indigo-700">
              🎨 Design online — free
            </span>
          )}
          {product.allows_pdf_upload && (
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-700">
              📄 Upload your PDF
            </span>
          )}
          <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 font-semibold text-amber-800">
            ⚡ Express 24h
          </span>
        </div>

        <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <ProductConfigurator client:only="react" slug={slug!} />
        </div>

        <details class="mt-6 rounded-xl bg-slate-50 p-4 text-sm">
          <summary class="cursor-pointer font-semibold text-slate-900">Specifications & material</summary>
          <ul class="mt-3 space-y-1 text-slate-600">
            <li>• Premium silk / matt papers, FSC-certified</li>
            <li>• Vibrant CMYK + spot-colour printing on Heidelberg presses</li>
            <li>• Bleed: 3 mm · safe area: 5 mm</li>
            <li>• File formats: PDF (preferred), AI, PSD, JPEG</li>
            <li>• Production temp: 24h · ships within EU 1–5 business days</li>
          </ul>
        </details>
      </div>
    </div>
  </div>
</BaseLayout>
