---
import BaseLayout from '~/layouts/BaseLayout.astro';

const apiBase = process.env.INTERNAL_API_URL ?? process.env.PUBLIC_API_URL ?? 'http://localhost:8000/api/v1';
type Product = {
  id: string; slug: string; name: string; description?: string; category?: { name: string; slug: string } | null;
  metadata_json?: { from_price?: number; image_color?: string; icon?: string };
};
let products: Product[] = [];
try {
  const res = await fetch(`${apiBase}/products?per_page=20`);
  products = (await res.json())?.data?.data ?? [];
} catch {}

const categories = [
  { slug: 'cards',      name: 'Cards & Invites',          tag: 'from €12',     img: '/images/banners/category-cards.png' },
  { slug: 'marketing',  name: 'Marketing & Promotion',    tag: 'from €8.99',   img: '/images/banners/category-marketing.png' },
  { slug: 'stationery', name: 'Office & Stationery',      tag: 'from €18',     img: '/images/banners/category-stationery.png' },
  { slug: 'signage',    name: 'Signage & Banners',        tag: 'from €4',      img: '/images/banners/category-signage.png' },
];
---
<BaseLayout title="PrintHub — premium online printing">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-indigo-50 via-white to-amber-50">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-12 md:grid-cols-2 md:py-20">
      <div>
        <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900">
          ✨ 20% off your first order — code <span class="font-mono">PRINT20</span>
        </span>
        <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 md:text-5xl lg:text-6xl">
          Print that <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">stands out</span>.<br>
          Delivered across Europe.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">
          Business cards, flyers, brochures, posters and more — designed online,
          printed in 24 hours, shipped from our German press.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/products" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-6 py-3 text-base font-bold text-white shadow-lg shadow-indigo-600/30 hover:bg-indigo-700">
            Shop all products
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/products/business-card" class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-800 hover:bg-slate-50">
            Design business cards
          </a>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-6 text-sm text-slate-600">
          <div class="flex items-center gap-2">
            <span class="text-amber-500">★★★★★</span> <strong class="text-slate-900">4.7</strong> / 5 — 12 000 reviews
          </div>
          <div class="flex items-center gap-1.5"><span>🇪🇺</span> Free EU delivery from €99</div>
        </div>
      </div>
      <div class="relative">
        <img
          src="/images/banners/hero.png"
          alt="Premium printed materials laid out artistically"
          class="aspect-square w-full rounded-3xl object-cover shadow-2xl"
          width="600"
          height="600"
        />
        <div class="absolute -bottom-4 -left-4 hidden rounded-xl bg-white p-4 shadow-xl ring-1 ring-slate-200 md:block">
          <div class="flex items-center gap-3">
            <div class="grid h-10 w-10 place-items-center rounded-full bg-emerald-100 text-emerald-600">✓</div>
            <div>
              <div class="text-sm font-bold text-slate-900">24h production</div>
              <div class="text-xs text-slate-500">Order today, ship tomorrow</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-6 text-sm text-slate-700 md:grid-cols-4">
      <div class="flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-full bg-indigo-100 text-indigo-600">🚚</div>
        <div><div class="font-semibold">24h production</div><div class="text-xs text-slate-500">Order today, ship tomorrow</div></div>
      </div>
      <div class="flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-full bg-amber-100 text-amber-600">🎨</div>
        <div><div class="font-semibold">Free design tool</div><div class="text-xs text-slate-500">Or upload your own PDF</div></div>
      </div>
      <div class="flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-full bg-emerald-100 text-emerald-600">🛡️</div>
        <div><div class="font-semibold">Quality guarantee</div><div class="text-xs text-slate-500">100% reprint policy</div></div>
      </div>
      <div class="flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-full bg-rose-100 text-rose-600">🇪🇺</div>
        <div><div class="font-semibold">EU-printed</div><div class="text-xs text-slate-500">Berlin · GDPR-friendly</div></div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">Shop by category</h2>
          <p class="mt-2 text-slate-600">Hand-picked product ranges for every business need.</p>
        </div>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {categories.map((c) => (
          <a href={`/products?category=${c.slug}`} class="group block overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-xl">
            <div class="aspect-[4/3] overflow-hidden bg-slate-100">
              <img src={c.img} alt={c.name} class="h-full w-full object-cover transition group-hover:scale-105" loading="lazy" width="600" height="450" />
            </div>
            <div class="p-5">
              <div class="text-xs font-bold uppercase tracking-wide text-amber-600">{c.tag}</div>
              <div class="mt-1 text-lg font-bold text-slate-900 group-hover:text-indigo-600">{c.name}</div>
              <div class="mt-1 text-sm text-indigo-600 opacity-0 transition group-hover:opacity-100">Shop now →</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured products -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">Bestsellers</h2>
          <p class="mt-2 text-slate-600">Our most-ordered products, ready in 24 hours.</p>
        </div>
        <a href="/products" class="hidden text-sm font-semibold text-indigo-600 hover:underline md:inline">View all →</a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {products.slice(0, 8).map((p) => (
          <a
            href={`/products/${p.slug}`}
            class="group block overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-xl"
          >
            <div class="aspect-square overflow-hidden bg-slate-100">
              <img
                src={`/images/products/${p.slug}.png`}
                alt={p.name}
                class="h-full w-full object-cover transition group-hover:scale-105"
                loading="lazy"
                width="400"
                height="400"
                onerror="this.style.opacity=0.3"
              />
            </div>
            <div class="p-4">
              <div class="text-xs font-medium uppercase tracking-wide text-slate-500">{p.category?.name ?? ''}</div>
              <div class="mt-1 font-bold text-slate-900 group-hover:text-indigo-600">{p.name}</div>
              <div class="mt-3 flex items-end justify-between">
                <div class="text-sm text-slate-500">
                  from <span class="text-base font-extrabold text-slate-900">€{(p.metadata_json?.from_price ?? 0).toFixed(2)}</span>
                </div>
                <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-800">24h</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Promo strip -->
  <section class="relative overflow-hidden bg-gradient-to-r from-indigo-600 to-purple-700 py-16 text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">Need design help?</h2>
        <p class="mt-3 text-lg text-indigo-100">
          Our online designer is free to use — no software required. Or upload your own PDF and we'll handle the rest.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/products/business-card" class="rounded-lg bg-white px-6 py-3 font-bold text-indigo-700 hover:bg-amber-50">
            Try the designer
          </a>
          <a href="/products" class="rounded-lg border border-white/30 px-6 py-3 font-semibold text-white hover:bg-white/10">
            Browse products
          </a>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <img src="/images/products/business-card.png" alt="" class="aspect-square rounded-xl object-cover shadow-2xl" width="200" height="200" loading="lazy" />
        <img src="/images/products/flyer.png" alt="" class="aspect-square rounded-xl object-cover shadow-2xl translate-y-6" width="200" height="200" loading="lazy" />
        <img src="/images/products/postcard.png" alt="" class="aspect-square rounded-xl object-cover shadow-2xl" width="200" height="200" loading="lazy" />
      </div>
    </div>
  </section>
</BaseLayout>
