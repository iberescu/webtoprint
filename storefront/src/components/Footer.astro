---
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-slate-200 bg-brand-700 text-slate-200">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 md:grid-cols-4">
    <div>
      <img src="/images/logo.svg" alt="CloudLab Print" class="h-8 w-auto brightness-0 invert" height="32" />
      <p class="mt-4 text-sm text-slate-300">
        Premium online printing on the CloudLab platform. 24-hour production, free EU delivery from €99.
      </p>
      <div class="mt-4 flex gap-3 text-slate-400">
        <a href="#" aria-label="LinkedIn" class="hover:text-white">in</a>
        <a href="#" aria-label="Twitter" class="hover:text-white">𝕏</a>
        <a href="#" aria-label="Instagram" class="hover:text-white">📷</a>
      </div>
    </div>

    <div>
      <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-white/80">Shop</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/products" class="hover:text-white">All products</a></li>
        <li><a href="/products?category=cards" class="hover:text-white">Cards & Invites</a></li>
        <li><a href="/products?category=marketing" class="hover:text-white">Marketing</a></li>
        <li><a href="/products?category=stationery" class="hover:text-white">Stationery</a></li>
        <li><a href="/products?category=signage" class="hover:text-white">Signage</a></li>
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-white/80">Help</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="#" class="hover:text-white">Design help</a></li>
        <li><a href="#" class="hover:text-white">Delivery & shipping</a></li>
        <li><a href="#" class="hover:text-white">Returns</a></li>
        <li><a href="#" class="hover:text-white">Contact us</a></li>
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-white/80">Legal</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/legal/privacy" class="hover:text-white">Privacy policy</a></li>
        <li><a href="/legal/cookies" class="hover:text-white">Cookie policy</a></li>
        <li><a href="/legal/terms" class="hover:text-white">Terms of service</a></li>
        <li><a href="/legal/imprint" class="hover:text-white">Imprint / Impressum</a></li>
        <li><a href="/legal/gdpr" class="hover:text-white">My data (GDPR)</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-brand-600 px-4 py-4 text-center text-xs text-slate-400">
    © {year} CloudLab Solutions · Berlin, Germany · VAT ID DE123456789 · Prices in EUR, VAT shown at checkout
  </div>
</footer>
