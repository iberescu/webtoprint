.env
.env.*
!.env.example

node_modules/
vendor/
dist/
build/
.cache/
.parcel-cache/
.astro/
.vite/
.phpunit.cache/

backend/storage/app/*
!backend/storage/app/.gitkeep
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitkeep
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitkeep
backend/public/storage

*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

.claude/

# Laravel's auto-generated services cache (per app). The hand-curated
# packages.php in backend-shop/ IS tracked — see CHANGELOG split entry.
backend-shop/bootstrap/cache/services.php
backend-shop/bootstrap/cache/config.php
backend-shop/bootstrap/cache/routes-v7.php

# backend-shop storage (mirrors backend/storage/* rules above)
backend-shop/storage/app/*
!backend-shop/storage/app/.gitkeep
backend-shop/storage/framework/cache/*
!backend-shop/storage/framework/cache/.gitkeep
backend-shop/storage/framework/sessions/*
!backend-shop/storage/framework/sessions/.gitkeep
backend-shop/storage/framework/views/*
!backend-shop/storage/framework/views/.gitkeep
backend-shop/storage/logs/*
!backend-shop/storage/logs/.gitkeep

# Filament's published assets — regenerated by `php artisan filament:assets`,
# bump on every Filament upgrade. Keeping them out of git avoids diff noise.
backend/public/css/filament/
backend/public/js/filament/

# pnpm's per-project store directory (created when pnpm install runs inside
# the container) — large, machine-specific, regenerable.
**/.pnpm-store/
